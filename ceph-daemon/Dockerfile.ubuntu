# syntax=docker/dockerfile:1
ARG FROM=quay.io/airshipit/ubuntu:noble
FROM ${FROM}

ARG KUBE_VERSION=1.36.3
ARG CONFD_VERSION=0.16.0

ARG CEPH_RELEASE
ARG CEPH_RELEASE_TAG
ARG CEPH_REPO
ARG CEPH_KEY

ARG DEBIAN_FRONTEND=noninteractive

RUN set -ex \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
         ca-certificates \
         gnupg2 \
         curl \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL ${CEPH_KEY} -o /tmp/ceph-release.asc \
    && gpg --batch --dearmor -o /etc/apt/keyrings/ceph.acs /tmp/ceph-release.asc \
    && rm -f /tmp/ceph-release.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/etc/apt/keyrings/ceph.acs] ${CEPH_REPO} ${VERSION_CODENAME} main" \
        > /etc/apt/sources.list.d/ceph.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
         ceph=${CEPH_RELEASE_TAG} \
         ceph-mds=${CEPH_RELEASE_TAG} \
         radosgw=${CEPH_RELEASE_TAG} \
         ceph-fuse=${CEPH_RELEASE_TAG} \
         ceph-volume=${CEPH_RELEASE_TAG} \
         rbd-nbd=${CEPH_RELEASE_TAG} \
         rbd-mirror=${CEPH_RELEASE_TAG} \
         rbd-fuse=${CEPH_RELEASE_TAG} \
         gdisk \
         udev \
         s3cmd \
         smartmontools \
         strace \
         tcpdump \
         sdparm \
         rsync \
         python3 \
         python3-openstackclient \
         python3-swiftclient \
         uuid-runtime \
         alien \
         jq \
    && rm -f /usr/lib/python*/EXTERNALLY-MANAGED \
    && curl -fsSL https://bootstrap.pypa.io/pip/get-pip.py -o /tmp/get-pip.py \
    && python3 /tmp/get-pip.py \
    && rm -f /tmp/get-pip.py \
    && pip3 install --no-cache-dir setuptools==70.3.0 \
    && curl -fsSL https://dl.k8s.io/v${KUBE_VERSION}/bin/linux/amd64/kubectl \
         -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && curl -fsSL https://github.com/kelseyhightower/confd/releases/download/v${CONFD_VERSION}/confd-${CONFD_VERSION}-linux-amd64 \
         -o /usr/local/bin/confd \
    && chmod +xr /usr/local/bin/confd \
    && curl -fsSL https://downloads.dell.com/FOLDER05235308M/1/perccli_linux_NF8G9_A07_7.529.00.tar.gz \
         -o /tmp/perccli.tar.gz \
    && tar -xzC /tmp -f /tmp/perccli.tar.gz \
    && alien -i /tmp/perccli_7.5-007.0529_linux/Linux/perccli-007.0529.0000.0000-1.noarch.rpm \
    && mkdir -p /etc/confd/conf.d /etc/confd/templates \
    && apt-get purge -y --auto-remove alien \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
              /tmp/* \
              /usr/share/{doc,man,locale}
